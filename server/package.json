{
  "name": "transitflow-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "setup:local": "tsx src/bootstrapLocal.ts",
    "data:manifest": "tsx src/generateDataManifest.ts",
    "sync:data": "tsx src/syncData.ts",
    "sync:data:dry": "tsx src/syncData.ts --dry-run",
    "verify:data": "tsx src/verifyTransitData.ts",
    "restore:route": "tsx src/restoreRouteFromSource.ts",
    "benchmark:journey": "tsx src/benchmarkJourney.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
