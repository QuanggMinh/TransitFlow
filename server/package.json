    "helmet": "^8.3.0",
    "mongoose": "^8.24.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
