PORT=5000
MONGODB_URI=mongodb://localhost:27017/transitflow
NODE_ENV=development

# Optional: when empty, traffic data uses the time-based simulation.
TOMTOM_API_KEY=

# Comma-separated frontend origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable only when deployed behind one trusted reverse proxy.
TRUST_PROXY=false

# Nominatim asks applications to identify themselves. Add a project contact.
APP_USER_AGENT=TransitFlow/1.0 (contact: your-email@example.com)

# Local development credentials. Change them before sharing a deployed instance.
ADMIN_USERNAME=admin@local.test
ADMIN_PASSWORD=change-me-to-a-strong-unique-password
